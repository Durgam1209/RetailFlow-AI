# Copy to .env and fill in local development values. Keep .env out of Git.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your_publishable_or_legacy_anon_key
WEATHER_KEY=your_openweather_api_key_optional

# Forecast sparse-history policy (calendar days; default assumes the shop is open daily).
MIN_ITEM_HISTORY_DAYS=28
MIN_ITEM_NONZERO_DAYS=7
SHOP_CLOSED_DATES=

# Basket rule quality thresholds.
BASKET_MIN_TRANSACTIONS=20
BASKET_MIN_SUPPORT_COUNT=3
BASKET_MIN_LIFT=1.2
METRIC_REGRESSION_THRESHOLD=0.25
PIPELINE_LOG_LEVEL=INFO

# NEVER PUT THE SERVICE ROLE KEY HERE.
# SUPABASE_SERVICE_ROLE_KEY belongs only in the nightly GitHub Actions Secret.
